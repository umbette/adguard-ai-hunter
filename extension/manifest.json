{
  "manifest_version": 3,
  "name": "Hunter Shield",
  "version": "0.1.0",
  "description": "Protezione locale da phishing, truffe e domini ingannevoli. Elaborazione 100% in-browser, zero telemetria.",
  "permissions": [
    "declarativeNetRequest",
    "storage",
    "webNavigation"
  ],
  "host_permissions": [],
  "declarative_net_request": {
    "rule_resources": [
      {
        "id": "ai_hunter_ruleset",
        "enabled": true,
        "path": "rules/ruleset.json"
      }
    ]
  },
  "web_accessible_resources": [
    {
      "resources": [
        "pages/blocked.html",
        "pages/blocked.js"
      ],
      "matches": ["<all_urls>"]
    }
  ],
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "AI Hunter Shield",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "background/service_worker.js"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
