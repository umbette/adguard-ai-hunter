{
  "manifest_version": 3,
  "name": "Sentinel Shield",
  "short_name": "Sentinel",
  "version": "0.4.1",
  "description": "Protezione locale in-browser contro phishing, imitazione brand, dynamic pricing e cookie/tracker di terze parti. 100% offline, zero telemetria.",
  "permissions": [
    "activeTab",
    "declarativeNetRequest",
    "storage",
    "webNavigation"
  ],
  "optional_permissions": [
    "cookies"
  ],
  "host_permissions": [],
  "optional_host_permissions": [
    "<all_urls>"
  ],
  "declarative_net_request": {
    "rule_resources": [
      {
        "id": "sentinel_ruleset",
        "enabled": true,
        "path": "rules/ruleset.json"
      },
      {
        "id": "pricing_tracker_ruleset",
        "enabled": true,
        "path": "rules/pricing_trackers.json"
      }
    ]
  },
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "Sentinel Shield",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "background/service_worker.js"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
